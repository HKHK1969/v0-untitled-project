// Type definitions (FieldType, Field, TableDefinition) - Moved to top for global access

// Helper function to get a table definition from the CURRENT schema
export function getTable(tableId: string): TableDefinition | undefined {
  const schema = getCurrentSchema(); // Get current schema state
  return schema.find((t) => t.id === tableId);
}

// Helper function to get a field definition from the CURRENT schema
export function getField(tableId: string, fieldId: string): Field | undefined {
  const table = getTable(tableId);
  return table?.fields.find((f) => f.id === fieldId);
}

// Helper function to get field options (supports dynamic options) - Uses CURRENT schema
export async function getFieldOptions(tableId: string, fieldId: string): Promise<string[]> {
    const field = getField(tableId, fieldId); // Uses helper which gets current schema
    if (!field || (field.type !== "dropdown" && field.type !== "select")) return [];

    if (typeof field.options === "function") {
        try {
            // Ensure the function returns string[]
            const dynamicOptions = await field.options();
            return Array.isArray(dynamicOptions) ? dynamicOptions.map(String) : [];
        } catch (error) {
            console.error(`Error fetching dynamic options for ${tableId}.${fieldId}:`, error);
            return [];
        }
    }
    // Ensure static options are strings
    return Array.isArray(field.options) ? field.options.map(String) : [];
}


// Helper function to validate a record against a table schema - Uses CURRENT schema
export function validateRecord(tableId: string, record: Record<string, any>): { valid: boolean; errors: Record<string, string> } { // Return errors per field
  const table = getTable(tableId); // Get current schema definition
  if (!table) return { valid: false, errors: { form: `Table schema '${tableId}' not found` } };

  const errors: Record<string, string> = {}; // Store errors keyed by field ID

  // Check required fields
  table.fields
    .filter((field) => field.required)
    .forEach((field) => {
      const value = record[field.id];
      if (value === undefined || value === null || String(value).trim() === "") {
        errors[field.id] = `${field.label} is required`;
      }
    });

  // Check field types and constraints
  table.fields.forEach((field) => {
    // Skip further checks if already marked as required and missing
    if (errors[field.id] && field.required) return;

    const value = record[field.id];
    // Skip validation if field is not required and value is empty/null/undefined
    if (!field.required && (value === undefined || value === null || String(value).trim() === "")) {
        return;
    }


    // Type specific validations
    switch (field.type) {
      case "number":
      case "currency":
        if (isNaN(Number(value))) {
          errors[field.id] = `${field.label} must be a valid number`;
        }
        break;
      case "date":
        if (!(value instanceof Date) && isNaN(Date.parse(String(value)))) {
          errors[field.id] = `${field.label} must be a valid date`;
        }
        break;
      case "email":
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value))) {
          errors[field.id] = `${field.label} must be a valid email address`;
        }
        break;
      case "phone":
        if (!/^[+]?[(]?\d{1,4}[)]?[-\s.]?\d{1,4}[-\s.]?\d{1,9}$/.test(String(value))) {
           errors[field.id] = `${field.label} must be a valid phone number format`;
         }
        break;
       case "url":
         try {
             // Basic URL validation, requires http/https protocol
             const url = new URL(String(value));
             if (url.protocol !== "http:" && url.protocol !== "https:") {
                 throw new Error("Invalid protocol");
             }
         } catch (_) {
             errors[field.id] = `${field.label} must be a valid URL (e.g., https://example.com)`;
         }
         break;
      case "boolean":
         if (typeof value !== 'boolean') {
             errors[field.id] = `${field.label} must be a true/false value`;
         }
         break;
      // Add validation for image/file if needed (e.g., check for URL format or object structure)
    }

    // Check maxLength
    if (!errors[field.id] && field.maxLength && (field.type === 'text' || field.type === 'longtext' || field.type === 'textarea') && String(value).length > field.maxLength) {
        errors[field.id] = `${field.label} cannot exceed ${field.maxLength} characters`;
    }

     // Note: 'unique' check requires comparing against other records - typically server-side.
     // Note: 'formula' fields are usually calculated, not validated as input.
     // Note: 'dropdown'/'select' validation against dynamic options is complex client-side.

  });

  return { valid: Object.keys(errors).length === 0, errors };
}
