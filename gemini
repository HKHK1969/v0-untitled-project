  "boolean", "dropdown", "select", "textarea", "currency",
  // "image", "file", // Require more complex UI/handling, omitted for now
  // "formula", // Requires calculation engine, omitted for now
];
const DEBOUNCE_DELAY_CREATE = 300;

export default function CreateTablePage() {
  const [fields, setFields] = useState<CreateFieldState[]>([{ id: Date.now(), name: "", type: "text", required: false }]);
  const [tableName, setTableName] = useState<string>("");
  const [tableDescription, setTableDescription] = useState<string>("");
  const [isSubmitting, setIsSubmitting] = useState<boolean>(false);
  const [formErrors, setFormErrors] = useState<Record<string, string>>({}); // Store validation errors

  // Debounced setters (less critical now with direct state updates)
  // const debouncedSetTableName = useMemo(() => debounce((value: string) => setTableName(value), DEBOUNCE_DELAY_CREATE), []);
  // const debouncedSetTableDescription = useMemo(() => debounce((value: string) => setTableDescription(value), DEBOUNCE_DELAY_CREATE), []);
  // useEffect(() => { /* Cleanup */ }, []);

  const addField = useCallback(() => {
    setFields((prev) => [...prev, { id: Date.now(), name: "", type: "text", required: false }]);
  }, []);

  const removeField = useCallback((id: number) => {
    setFields((prev) => {
        // Prevent removing the last field
        if (prev.length <= 1) return prev;
        return prev.filter((field) => field.id !== id);
    });
  }, []);


  const updateField = useCallback((id: number, key: keyof CreateFieldState, value: string | boolean) => {
    setFields((prev) => prev.map((field) => (field.id === id ? { ...field, [key]: value } : field)));
     // Clear errors for the specific field being updated
     setFormErrors(prevErrors => {
         const newErrors = { ...prevErrors };
         delete newErrors[`field_${id}_name`]; // Clear potential name error for this field
         delete newErrors[`field_${id}_id`];   // Clear potential ID error for this field
         return newErrors;
     });
  }, []);

  // Validation function
  const validateForm = useCallback((): boolean => {
    const errors: Record<string, string> = {};
    const resultingTableId = tableName.trim().toLowerCase().replace(/\s+/g, "_");

    if (!tableName.trim()) {
      errors.tableName = "Table name is required";
    } else if (!/^[a-zA-Z][a-zA-Z0-9_]*$/.test(resultingTableId)) {
      errors.tableName = "Table name must result in a valid ID (starts with letter, then letters, numbers, underscores)";
    } else if (getTable(resultingTableId)) { // Check if table ID already exists
        errors.tableName = `A table with ID '${resultingTableId}' already exists.`;
    }

    if (fields.length === 0) {
      errors.form = "At least one field is required"; // General form error
    }

    const fieldNames = new Set<string>();
    const fieldIds = new Set<string>();

    fields.forEach(field => {
      const trimmedName = field.name.trim();
      const resultingFieldId = trimmedName.toLowerCase().replace(/\s+/g, "_");

      if (!trimmedName) {
        errors[`field_${field.id}_name`] = "Field name is required";
      } else {
          if (!/^[a-zA-Z][a-zA-Z0-9_]*$/.test(resultingFieldId)) {
              errors[`field_${field.id}_name`] = `Name results in invalid ID ('${resultingFieldId}'). Use letters, numbers, underscores, starting with letter.`;
          } else if (fieldIds.has(resultingFieldId)) {
              errors[`field_${field.id}_name`] = `Field name results in duplicate ID '${resultingFieldId}'`;
          } else {
              fieldIds.add(resultingFieldId);
          }
          // Check for duplicate display names (optional but good UX)
          if (fieldNames.has(trimmedName)) {
               errors[`field_${field.id}_name`] = `Field name "${trimmedName}" is duplicated`;
           } else {
               fieldNames.add(trimmedName);
           }
      }
    });

    setFormErrors(errors);
    return Object.keys(errors).length === 0; // Valid if no errors
  }, [tableName, fields]); // Dependencies for validation


  // Handle table creation using the centralized function
  const handleCreateTable = useCallback(async () => {
    if (!validateForm()) {
        toastMock({ title: "Validation Failed", description: "Please fix the errors indicated.", variant: "destructive" });
        return;
    }

    setIsSubmitting(true);
    setFormErrors({}); // Clear previous errors on successful validation


    try {
      const tableId = tableName.trim().toLowerCase().replace(/\s+/g, "_");
      const schemaFields: Partial<Field>[] = fields.map(f => ({
        id: f.name.trim().toLowerCase().replace(/\s+/g, "_"),
        label: f.name.trim(),
        type: f.type,
        required: f.required,
      }));

      // Use the refactored addTable function
      const success = addTable(
        {
          id: tableId,
          name: tableName.trim(),
          description: tableDescription.trim(),
          fields: schemaFields
        },
        {
          onError: (err, context) => {
            console.error(`Error in ${context}:`, err);
            // Display error specific to table creation failure
            setFormErrors({ form: `Failed to create table: ${err.message}` });
            toastMock({ title: "Creation Error", description: err.message, variant: "destructive" });
          }
        }
      );

      if (success) {
        toastMock({ title: "Success", description: `Table "${tableName.trim()}" created successfully. Redirecting...`, variant: "default" });
        setTimeout(() => {
          if (typeof window !== 'undefined') window.location.href = "/tables"; // Adjust target route
        }, 1500);
      }
      // No 'else' needed, error handled by onError callback

    } catch (error) { // Catch unexpected errors in this handler's logic
      console.error("Unexpected error during table creation submission:", error);
      setFormErrors({ form: `An unexpected error occurred: ${error instanceof Error ? error.message : "Unknown error"}` });
      toastMock({ title: "Error", description: "An unexpected error occurred.", variant: "destructive" });
    } finally {
      setIsSubmitting(false);
    }
  }, [tableName, tableDescription, fields, validateForm]); // Add dependencies


  return (
    <div className="flex min-h-screen flex-col">
      {/* Header */}
       <header className="bg-background border-b">
         <div className="container flex h-16 items-center px-4 md:px-6">
           <Link href="/" className="text-lg font-semibold">Apparel Supply Chain Tracker</Link>
           <nav className="ml-auto flex gap-4 sm:gap-6">
             <Link href="/dashboard" className="text-sm font-medium hover:underline underline-offset-4">Dashboard</Link>
             <Link href="/tables" className="text-sm font-medium hover:underline underline-offset-4">Tables</Link>
           </nav>
         </div>
       </header>
       {/* Main Content */}
      <main className="flex-1 p-4 md:p-6">
        <div className="mx-auto max-w-3xl grid gap-4 md:gap-8">
           {/* Back Button & Title */}
           <div className="flex items-center">
             <Button variant="ghost" size="icon" asChild className="mr-2"><Link href="/tables"><ArrowLeft className="h-4 w-4" /><span className="sr-only">Back to Tables</span></Link></Button>
             <h1 className="text-2xl font-bold tracking-tight">Create New Table</h1>
           </div>

           {/* General Form Errors */}
           {formErrors.form && <p className="text-sm text-destructive bg-destructive/10 p-2 rounded-md">{formErrors.form}</p>}


           {/* Table Info Card */}
           <Card>
             <CardHeader>
               <CardTitle>Table Information</CardTitle>
               <CardDescription>Define the name and description for your new table.</CardDescription>
             </CardHeader>
             <CardContent className="grid gap-4">
               <div className="grid gap-2">
                 <Label htmlFor="table-name">Table Name</Label>
                 <Input
                   id="table-name"
                   placeholder="e.g., Products, Orders"
                   value={tableName}
                   onChange={(e) => { setTableName(e.target.value); setFormErrors(p => ({...p, tableName: undefined, form: undefined})); }}
                   className={formErrors.tableName ? "border-destructive" : ""}
                   aria-describedby={formErrors.tableName ? "table-name-error" : undefined}
                   aria-invalid={!!formErrors.tableName}
                 />
                 {formErrors.tableName && <p id="table-name-error" className="text-xs text-destructive">{formErrors.tableName}</p>}
               </div>
               <div className="grid gap-2">
                 <Label htmlFor="table-description">Description (Optional)</Label>
                 <Input
                   id="table-description"
                   placeholder="Describe the purpose of this table"
                   value={tableDescription}
                   onChange={(e) => setTableDescription(e.target.value)}
                 />
               </div>
             </CardContent>
           </Card>

           {/* Table Fields Card */}
           <Card>
             <CardHeader>
               <CardTitle>Table Fields</CardTitle>
               <CardDescription>Define the columns for your table. Each field name must be unique.</CardDescription>
             </CardHeader>
             <CardContent className="grid gap-6">
               {fields.map((field, index) => {
                   const nameErrorId = `field-${field.id}-name-error`;
                   const fieldNameError = formErrors[`field_${field.id}_name`];
                   return (
                       <div key={field.id} className={`grid gap-4 p-4 border rounded-lg relative ${fieldNameError ? 'border-destructive bg-destructive/5' : 'border-border'}`}>
                         {fields.length > 1 && (
                           <Button variant="ghost" size="icon" className="absolute top-2 right-2 text-muted-foreground hover:text-destructive" onClick={() => removeField(field.id)} aria-label="Remove field">
                             <Trash className="h-4 w-4" />
                           </Button>
                         )}
                         <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                           <div className="grid gap-2">
                             <Label htmlFor={`field-name-${field.id}`}>Field Name</Label>
                             <Input
                               id={`field-name-${field.id}`}
                               placeholder="e.g., sku, color, quantity"
                               value={field.name}
                               onChange={(e) => updateField(field.id, "name", e.target.value)}
                               className={fieldNameError ? "border-destructive" : ""}
                               aria-describedby={fieldNameError ? nameErrorId : undefined}
                               aria-invalid={!!fieldNameError}
                             />
                             {fieldNameError && <p id={nameErrorId} className="text-xs text-destructive">{fieldNameError}</p>}
                           </div>
                           <div className="grid gap-2">
                             <Label htmlFor={`field-type-${field.id}`}>Field Type</Label>
                             <Select value={field.type} onValueChange={(value) => updateField(field.id, "type", value as FieldType)}>
