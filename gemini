// Get related data (uses cache invalidation timestamp)
export const getRelatedTableData = memoize(
  (tableId: string, timestamp: number, config: RelationshipConfig = {}): RecordData[] => {
    if (typeof window === "undefined" || !localStorage) return [];
    console.log(`Fetching related data for ${tableId} with timestamp ${timestamp}`); // Log cache access

    try {
      const savedData = localStorage.getItem(`${DATA_KEY_PREFIX_REL}${tableId}_data`);
      return safeParseJSON<RecordData[]>(savedData, []); // Use safe parse
    } catch (e) {
      console.error(`Error loading data for table ${tableId}:`, e);
      config.onError?.(e instanceof Error ? e : new Error("Unknown error"), `getRelatedTableData(${tableId})`);
      return [];
    }
  },
  // Cache key includes tableId and the invalidation timestamp
  (tableId, timestamp) => `${tableId}-${timestamp}`
);

// Get unique values (uses cache invalidation timestamp)
export const getUniqueFieldValues = memoize(
  (tableId: string, fieldId: string, timestamp: number, config: RelationshipConfig = {}): string[] => {
    console.log(`Fetching unique values for ${tableId}.${fieldId} with timestamp ${timestamp}`); // Log cache access
    const tableData = getRelatedTableData(tableId, timestamp, config); // Use cached data if timestamp matches
    const uniqueValues = new Set<string>();

    tableData.forEach((record) => {
      const value = record[fieldId];
      if (Array.isArray(value)) {
        value.forEach((item) => {
          const strItem = safeToString(item); // Use helper
          if (strItem !== "") uniqueValues.add(strItem);
        });
      } else {
        const strValue = safeToString(value); // Use helper
        if (strValue !== "") uniqueValues.add(strValue);
      }
    });

    return Array.from(uniqueValues).sort();
  },
   // Cache key includes table, field, and timestamp
   (tableId, fieldId, timestamp) => `${tableId}-${fieldId}-${timestamp}`
);


// Find Related Table (uses memoized map)
export function findRelatedTable(fieldId: string): string | null {
  const fieldToTableMap = getFieldToTableMap(); // Uses memoized map
  const relatedTable = fieldToTableMap[fieldId];
  // No warning needed here, it's normal for many fields
  return relatedTable || null;
}

// Get Display Field (uses memoized map)
export function getDisplayField(tableId: string): string {
  const tableToDisplayFieldMap = getTableToDisplayFieldMap(); // Uses memoized map
  const displayField = tableToDisplayFieldMap[tableId];
  if (!displayField) {
    console.warn(`No display field configured for table '${tableId}', falling back to 'id'.`);
  }
  return displayField || "id";
}

// Get Relationship Options (uses current schema and unique values)
export async function getRelationshipOptions(fieldId: string, config: RelationshipConfig = {}): Promise<string[]> {
  const relatedTableId = findRelatedTable(fieldId);
  if (!relatedTableId) return [];

  const field = getField(relatedTableId, fieldId); // Use helper

  // Handle dynamic options function
  if (field?.options && typeof field.options === "function") {
    try {
      return await field.options();
    } catch (e) {
      console.error(`Error fetching dynamic options for ${relatedTableId}.${fieldId}:`, e);
      config.onError?.(e instanceof Error ? e : new Error("Unknown error fetching dynamic options"), `getRelationshipOptions(${fieldId})`);
      return [];
    }
  }

  // Handle static linked data
  const displayFieldId = getDisplayField(relatedTableId);
  if (!getField(relatedTableId, displayFieldId)) { // Validate display field exists
      console.error(`Display field '${displayFieldId}' not found in table '${relatedTableId}' for relationship options of '${fieldId}'.`);
      return [];
  }

  // Use the timestamp for cache-aware fetching
  const timestamp = cacheInvalidationTimestamps[relatedTableId] || 0;
  return getUniqueFieldValues(relatedTableId, displayFieldId, timestamp, config);
}
