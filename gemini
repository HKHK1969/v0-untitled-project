      toastMock({ title: "Error", description: "No backup data loaded to restore.", variant: "destructive" });
      return;
    }
    const confirmed = window.confirm("WARNING: Restoring will overwrite all current data for the tables included in the backup file. This cannot be undone. Are you sure you want to proceed?");
