// Utility to safely parse JSON
function safeParseJSON<T>(json: string | null, defaultValue: T): T {
    if (json === null || json === undefined) return defaultValue;
    try {
        // Add basic check for empty string which is invalid JSON
        if (json.trim() === "") return defaultValue;
        return JSON.parse(json) as T;
    } catch (e) {
        console.error("Error parsing JSON:", e, "\nJSON string:", json.substring(0, 100)); // Log snippet
        return defaultValue;
    }
}


// Save data to localStorage with retry
export async function saveData(
  tableId: string,
  data: any[], // Expecting array of records
  options: PersistenceOptions = {},
): Promise<boolean> {
   if (typeof window === 'undefined' || !localStorage) {
       console.error("localStorage not available. Cannot save data.");
       options.onError?.(new Error("localStorage not available"));
       return false;
   }
   if (!Array.isArray(data)) {
        console.error(`Invalid data format for saveData (table: ${tableId}): Expected array.`);
        options.onError?.(new Error("Invalid data format: Expected array"));
        return false;
   }

  const storageKey = `${STORAGE_PREFIX_PERSIST}${tableId}_data`;
  let attempts = 0;

  const attemptSave = async (): Promise<boolean> => {
    try {
      const stringifiedData = JSON.stringify(data);
      localStorage.setItem(storageKey, stringifiedData);

      // Verify save (optional, can be slow)
      // if (localStorage.getItem(storageKey) !== stringifiedData) {
      //   throw new Error("Failed to verify data in localStorage. Storage might be full or write failed silently.");
      // }

      invalidateTableCache(tableId); // Invalidate cache after successful save
      options.onSuccess?.();
      return true;
    } catch (error) {
      console.error(`Error saving data for table ${tableId} (Attempt ${attempts + 1}):`, error);

      if (options.retryOnFailure && attempts < MAX_RETRY_ATTEMPTS_PERSIST) {
        attempts++;
        console.log(`Retrying save for ${tableId} (attempt ${attempts}/${MAX_RETRY_ATTEMPTS_PERSIST})...`);
        await new Promise(resolve => setTimeout(resolve, RETRY_DELAY_PERSIST * attempts));
        return attemptSave();
      }

      const typedError = error instanceof Error ? error : new Error("Unknown error saving data");
      options.onError?.(typedError);
      return false;
    }
  };

  return attemptSave();
}

// Load data from localStorage
export function loadData<T = Record<string, any>>(tableId: string, defaultValue: T[] = []): T[] {
    if (typeof window === 'undefined' || !localStorage) {
        console.warn("localStorage not available. Returning default value.");
        return defaultValue;
    }
    const storageKey = `${STORAGE_PREFIX_PERSIST}${tableId}_data`;
    try {
        const savedData = localStorage.getItem(storageKey);
        // Use safeParseJSON with the provided default value
        const parsedData = safeParseJSON<T[]>(savedData, defaultValue);
        // Ensure the result is an array, even if parsing returns something else unexpectedly
        return Array.isArray(parsedData) ? parsedData : defaultValue;
    } catch (error) {
        console.error(`Error loading data for table ${tableId}:`, error);
        return defaultValue; // Return default on any unexpected error during load
    }
}


