"use client"

// Imports handled globally

// Constants
// const ADD_NEW_VALUE_REL = "__add_new__"; // Not typically used here
const DEFAULT_PLACEHOLDER_REL = "Select Relationship...";

// Type definitions
// type SafeValue = string | number | boolean | Date | object | null | undefined; // Defined above
interface ParentFieldRel { id: string; value: string; } // Defined above
interface RelationshipSelectProps {
  id: string;
  label: string;
  value: SafeValue; // The *value* stored (e.g., the ID or unique name from the related table)
  sourceTable: string; // The table ID to fetch options from
  sourceField: string; // The field in the source table to use for option *labels* and potentially *values* if different
  valueField?: string; // Optional: The field in the source table to use for option *values* (defaults to sourceField if omitted)
  parentField?: ParentFieldRel; // For cascading filters
  onValueChange: (selectedValue: string) => void; // Returns the *value* of the selected relationship
  required?: boolean;
  placeholder?: string;
  error?: string;
  disabled?: boolean;
  // allowAddNew removed - adding should happen via the source table's UI, not directly here.
}

export const RelationshipSelect = memo(function RelationshipSelect({
  id,
  label,
  value, // This should be the *value* (e.g., ID) stored for the relationship
  sourceTable,
  sourceField, // Field for the display Label
  valueField, // Field for the actual Value (often an ID)
  parentField, // TODO: Implement filtering based on parentField
  onValueChange,
  required = false,
  placeholder = DEFAULT_PLACEHOLDER_REL,
  error,
  disabled = false,
}: RelationshipSelectProps) {

  const [options, setOptions] = useState<{ value: string, label: string }[]>([]); // Store {value, label} pairs
  const [isLoading, setIsLoading] = useState(false);

  const actualValueField = valueField || sourceField; // Use sourceField as value if valueField is not specified

  // Load options from the source table/field
  useEffect(() => {
    let isMounted = true;
    setIsLoading(true);
    setOptions([]); // Clear previous options

    const fetchOptions = async () => {
        try {
            // Fetch the full data from the related table
            // Use timestamp 0 for now, assuming cache invalidation handles updates elsewhere
            const relatedData = getRelatedTableData(sourceTable, cacheInvalidationTimestamps[sourceTable] || 0);

            // TODO: Implement filtering based on parentField if provided
            let filteredData = relatedData;
             if (parentField && parentField.value && parentField.id) {
                 console.log(`Filtering ${sourceTable} by ${parentField.id} = ${parentField.value}`);
                 filteredData = relatedData.filter(record => safeToString(record[parentField.id]) === parentField.value);
             } else {
                 console.log(`No parent filter applied to ${sourceTable}`);
             }


            // Map data to { value, label } format, ensuring uniqueness based on value
            const uniqueOptionsMap = new Map<string, string>();
            filteredData.forEach(record => {
                const optionValue = safeToString(record[actualValueField]);
                const optionLabel = safeToString(record[sourceField]);
                // Add if value is present and not already added
                if (optionValue && !uniqueOptionsMap.has(optionValue)) {
                    uniqueOptionsMap.set(optionValue, optionLabel || optionValue); // Use value as label if label field is empty
                }
            });

            // Convert map to array and sort by label
            const newOptions = Array.from(uniqueOptionsMap.entries())
                .map(([value, label]) => ({ value, label }))
                .sort((a, b) => a.label.localeCompare(b.label));


            if (isMounted) {
                setOptions(newOptions);
            }
        } catch (e) {
            console.error(`Error fetching relationship options for ${sourceTable}.${sourceField}:`, e);
             if (isMounted) {
                 sonnerToastMock.error("Failed to load relationship options", { description: `Could not fetch options for ${label}.` });
             }
        } finally {
            if (isMounted) setIsLoading(false);
        }
    };


    fetchOptions();

    return () => { isMounted = false; };
  }, [sourceTable, sourceField, actualValueField, label, parentField?.id, parentField?.value]); // Re-fetch if dependencies change


  // Convert the stored value (which should match an option's value) to string for the select
  const currentSelectValue = safeToString(value);

  return (
    <>
      <Select
        value={currentSelectValue || ""} // Use the stringified stored value
        onValueChange={(selectedValue) => {
            // selectedValue is the *value* (e.g., ID) from the <option>
            onValueChange(selectedValue);
        }}
        disabled={disabled || isLoading}
      >
        <SelectTrigger
          id={id}
          aria-invalid={!!error}
          className={error ? "border-destructive" : ""}
          aria-label={label}
        >
          <SelectValue placeholder={placeholder}>
            {isLoading ? "Loading..." : (
                // Find the label corresponding to the current value for display
                options.find(opt => opt.value === currentSelectValue)?.label || placeholder
            )}
          </SelectValue>
        </SelectTrigger>
        <SelectContent>
           {/* Placeholder */}
           {/* <SelectItem value="" disabled>{placeholder}</SelectItem> */}

          {isLoading ? (
            <SelectItem value="" disabled>Loading options...</SelectItem>
          ) : (
            options.length === 0 ? (
              <SelectItem value="" disabled>No options available</SelectItem>
            ) : (
              options.map((opt) => (
                <SelectItem key={`${id}-opt-${opt.value}`} value={opt.value}>
                  {opt.label} {/* Display label */}
                </SelectItem>
              ))
            )
          )}
           {/* "Add new" is generally not appropriate here */}
        </SelectContent>
      </Select>
      {error && <p className="text-xs text-destructive mt-1">{error}</p>}
    </>
  );
});
// --- End RelationshipSelect Refactor ---
