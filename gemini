// Utility to normalize field (ensure it adheres to Field interface)
const normalizeField = (fieldData: Partial<Field>): Field => {
    const fieldId = (fieldData.id || `field_${Date.now()}`).trim();
    const fieldLabel = (fieldData.label || fieldId).trim();
    let fieldType = (fieldData.type || "text") as FieldType;

    // Basic ID validation (adjust regex as needed)
    if (!/^[a-zA-Z][a-zA-Z0-9_]*$/.test(fieldId)) {
        console.warn(`Invalid field ID format: '${fieldId}'. Attempting sanitization.`);
        // Simple sanitization - replace invalid chars, ensure starts with letter
        let sanitizedId = fieldLabel.toLowerCase().replace(/[^a-z0-9_]/g, '_').replace(/_{2,}/g, '_');
        if (!/^[a-zA-Z]/.test(sanitizedId)) sanitizedId = 'f_' + sanitizedId;
        fieldData.id = sanitizedId.substring(0, 30); // Limit length
        console.warn(`Sanitized ID: '${fieldData.id}'`);
    }


    // Validate Type
    const validTypes: FieldType[] = [ "text", "longtext", "number", "date", "email", "phone", "dropdown", "image", "file", "boolean", "currency", "formula", "url", "select", "textarea"];
    if (!validTypes.includes(fieldType)) {
        console.warn(`Invalid field type '${fieldType}' for field '${fieldId}'. Defaulting to 'text'.`);
        fieldType = "text";
    }


    // Build the normalized field, including only relevant properties
    const normalized: Field = {
        id: fieldId,
        label: fieldLabel,
        type: fieldType,
        required: fieldData.required || false,
        notes: fieldData.notes || "",
        unique: fieldData.unique, // Keep if provided
        disabled: fieldData.disabled, // Keep if provided
        defaultValue: fieldData.defaultValue, // Keep if provided
    };


    // Type-specific properties
    if (fieldType === "dropdown" || fieldType === "select") {
        normalized.options = fieldData.options;
        normalized.linkedTable = fieldData.linkedTable;
        normalized.linkedField = fieldData.linkedField;
    }
    if ((fieldType === "text" || fieldType === "longtext" || fieldType === "textarea") && typeof fieldData.maxLength === 'number') {
        normalized.maxLength = fieldData.maxLength;
    }
    if (fieldType === "formula" && typeof fieldData.formula === 'string') {
        normalized.formula = fieldData.formula;
    }


    return normalized;
};


// Add Field to Table (Updates global schema state)
export function addFieldToTable(tableId: string, fieldData: Partial<Field>, config: SchemaConfig = {}): boolean {
  try {
    const currentSchema = getCurrentSchema(); // Get a copy
    const tableIndex = currentSchema.findIndex((t) => t.id === tableId);

    if (tableIndex === -1) {
      throw new Error(`Table ${tableId} not found`);
    }

    const normalizedField = normalizeField(fieldData); // Normalize the input

    // Check for duplicate ID within the target table
    if (currentSchema[tableIndex].fields.some((f) => f.id === normalizedField.id)) {
      throw new Error(`Field ${normalizedField.id} already exists in table ${tableId}`);
    }

    // Create the updated schema immutably
    const newSchema = currentSchema.map((table, index) => {
        if (index === tableIndex) {
            return {
                ...table,
                fields: [...table.fields, normalizedField] // Add the new field
            };
        }
        return table;
    });


    // Update the global state and persist
    if (updateGlobalSchema(newSchema)) {
        console.log(`Field ${normalizedField.id} added to table ${tableId} in schema state.`);
         // Invalidate relationship utils cache because schema changed
         // This requires a way to signal the change or clear memoized caches directly.
         // For now, log the need:
         console.warn("Schema changed: Relationship utils caches (maps) might be stale and need regeneration/clearing.");
         invalidateTableCache(tableId); // Invalidate data cache for the table
        return true;
    } else {
        throw new Error("Failed to update global schema state.");
    }


  } catch (error) {
    console.error("Error adding field to table:", error);
    config.onError?.(error instanceof Error ? error : new Error("Unknown error"), "addFieldToTable");
    return false;
  }
}

// Update Field in Table (Updates global schema state)
export function updateField(
  tableId: string,
  fieldId: string,
  updates: Partial<Field>,
  config: SchemaConfig = {},
): boolean {
  try {
     const currentSchema = getCurrentSchema(); // Get a copy
     const tableIndex = currentSchema.findIndex((t) => t.id === tableId);


     if (tableIndex === -1) throw new Error(`Table ${tableId} not found`);


     const fieldIndex = currentSchema[tableIndex].fields.findIndex((f) => f.id === fieldId);
     if (fieldIndex === -1) throw new Error(`Field ${fieldId} not found in table ${tableId}`);


     // Prevent changing ID via this function
     if (updates.id && updates.id !== fieldId) {
         console.warn(`Attempted to change field ID from '${fieldId}' to '${updates.id}' via updateField. Ignoring ID change.`);
         delete updates.id;
     }


     const originalField = currentSchema[tableIndex].fields[fieldIndex];
     const updatedFieldData = { ...originalField, ...updates };
     const normalizedUpdatedField = normalizeField(updatedFieldData); // Normalize the result


     // Create the updated schema immutably
     const newSchema = currentSchema.map((table, tIndex) => {
         if (tIndex === tableIndex) {
             return {
                 ...table,
                 fields: table.fields.map((field, fIndex) =>
                     fIndex === fieldIndex ? normalizedUpdatedField : field
                 )
             };
         }
         return table;
     });


     // Update the global state and persist
     if (updateGlobalSchema(newSchema)) {
         console.log(`Field ${fieldId} updated in table ${tableId} in schema state.`);
         console.warn("Schema changed: Relationship utils caches (maps) might be stale and need regeneration/clearing.");
          invalidateTableCache(tableId); // Invalidate data cache
         return true;
     } else {
         throw new Error("Failed to update global schema state.");
     }


  } catch (error) {
    console.error("Error updating field:", error);
    config.onError?.(error instanceof Error ? error : new Error("Unknown error"), "updateField");
    return false;
  }
}


// Add Table (Updates global schema state)
export function addTable(
  tableData: Omit<TableDefinition, "fields"> & { fields: Partial<Field>[] },
  config: SchemaConfig = {},
): boolean {
  try {
    const currentSchema = getCurrentSchema(); // Get a copy

     // Validate Table ID
     const tableId = tableData.id.trim();
     if (!tableId || !/^[a-zA-Z][a-zA-Z0-9_]*$/.test(tableId)) {
        throw new Error(`Invalid table ID: ${tableId}. Must start with a letter and contain only letters, numbers, and underscores.`);
     }
     if (currentSchema.some((t) => t.id === tableId)) {
       throw new Error(`Table ${tableId} already exists`);
     }


    // Normalize fields and check for duplicates within the new table
    const fieldIds = new Set<string>();
    const normalizedFields = tableData.fields.map(field => {
        const normField = normalizeField(field);
        if (fieldIds.has(normField.id)) {
            throw new Error(`Duplicate field ID '${normField.id}' in definition for new table '${tableId}'`);
        }
        fieldIds.add(normField.id);
        return normField;
    });


    // Add default 'dateCreated' field if missing
    if (!normalizedFields.some((f) => f.id === "dateCreated")) {
      normalizedFields.push(DEFAULT_DATE_FIELD_SCHEMA);
    }

    // Create the new table definition
    const newTable: TableDefinition = {
      id: tableId,
      name: tableData.name?.trim() || tableId,
      description: tableData.description?.trim() || "",
      fields: normalizedFields,
    };

    // Create the updated schema immutably
    const newSchema = [...currentSchema, newTable];

    // Update the global state and persist
    if (updateGlobalSchema(newSchema)) {
        console.log(`Table ${tableId} added to schema state.`);
        // Create the empty data storage for the new table
        if (typeof window !== 'undefined' && localStorage) {
            localStorage.setItem(`${DATA_KEY_PREFIX_SCHEMA}${newTable.id}_data`, JSON.stringify([]));
        }
         console.warn("Schema changed: Relationship utils caches (maps) might be stale and need regeneration/clearing.");
        return true;
    } else {
        throw new Error("Failed to update global schema state.");
    }

  } catch (error) {
    console.error("Error adding table:", error);
    config.onError?.(error instanceof Error ? error : new Error("Unknown error"), "addTable");
    return false;
  }
}

// Migrate Table Data (Operates directly on localStorage - no schema state change)
// This function remains largely the same as it modifies persisted data, not the schema definition itself.
export function migrateTableData(
  tableId: string,
  migrationFn: (record: RecordData) => RecordData,
  config: SchemaConfig = {},
): boolean {
  if (typeof window === "undefined" || !localStorage) return false;

  const dataKey = `${DATA_KEY_PREFIX_SCHEMA}${tableId}_data`;
  try {
    const savedData = localStorage.getItem(dataKey);
    if (!savedData) {
      console.log(`No data found for table ${tableId} to migrate.`);
      return true;
    }

    let data: RecordData[];
    try {
        data = JSON.parse(savedData);
        if (!Array.isArray(data)) throw new Error("Data is not an array");
    } catch (parseError) {
        throw new Error(`Data for table ${tableId} is corrupted or not an array: ${parseError}`);
    }

    let migrationErrors = 0;
    const migratedData = data.map((record, index) => {
      try {
        // Provide a deep copy to the migration function if it might mutate
        const recordCopy = JSON.parse(JSON.stringify(record));
        const migratedRecord = migrationFn(recordCopy);
         // Optional: Validate migratedRecord against schema? Could be slow.
        return migratedRecord;
      } catch (e) {
        migrationErrors++;
        console.warn(`Error migrating record at index ${index} in ${tableId}:`, e);
        return record; // Return original on error
      }
    });

    if (migrationErrors > 0) {
        console.warn(`Migration for table ${tableId} completed with ${migrationErrors} record errors.`);
        config.onError?.(new Error(`${migrationErrors} records failed to migrate in ${tableId}`), "migrateTableData - record error");
    }

    // Save migrated data back
    localStorage.setItem(dataKey, JSON.stringify(migratedData));
    console.log(`Migrated ${migratedData.length} records for table ${tableId}.`);
    invalidateTableCache(tableId); // Invalidate data cache
    return true;

  } catch (error) {
    console.error("Error during table data migration process:", error);
    config.onError?.(error instanceof Error ? error : new Error("Unknown migration error"), "migrateTableData - process");
    return false;
  }
}

