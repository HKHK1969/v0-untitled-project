// Central cache timestamp store
const cacheInvalidationTimestamps: Record<string, number> = {};
// Function to invalidate cache for a specific table
export function invalidateTableCache(tableId: string): void {
  cacheInvalidationTimestamps[tableId] = Date.now();
  // Clear memoized results that depend on this table
  getRelatedTableData.cache.delete(`${tableId}-${cacheInvalidationTimestamps[tableId]}`); // Requires lodash cache knowledge
