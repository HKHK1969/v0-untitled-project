const getFieldToTableMap = memoize((): Record<string, string> => {
  console.log("Generating Field -> Table Map (should re-run on schema change)"); // Log when it runs
  const map: Record<string, string> = {};
  const schema = getCurrentSchema(); // Use current schema
  schema.forEach((table) => {
    table.fields.forEach((field) => {
      map[field.id] = table.id;
      // Add aliases carefully, ensuring they don't overwrite valid mappings
      if (field.id === "companyName") {
          if (table.id === "customers" && !map["customer"]) map["customer"] = table.id;
          if (table.id === "suppliers" && !map["supplier"]) map["supplier"] = table.id;
      }
      // ... other aliases ...
       if (field.id === "poNumber" && table.id === "customerPOs" && !map["customerPO"]) map["customerPO"] = table.id;
    });
  });
  return map;
});

const getTableToDisplayFieldMap = memoize((): Record<string, string> => {
   console.log("Generating Table -> Display Field Map (should re-run on schema change)"); // Log when it runs
  const map: Record<string, string> = {};
  const schema = getCurrentSchema(); // Use current schema
  schema.forEach((table) => {
    const displayField =
        table.fields.find((f) => f.type === "text")?.id || // Prefer text
        table.fields.find((f) => f.type === "dropdown")?.id || // Then dropdown
        table.fields.find((f) => f.type === "email")?.id || // Then email
