// Get storage usage statistics
export function getStorageStats(): { usedBytes: number, totalBytes: number | null, tables: Record<string, number> } {
    if (typeof window === 'undefined' || !localStorage) {
        console.warn("localStorage not available. Cannot get storage stats.");
        return { usedBytes: 0, totalBytes: null, tables: {} };
    }
    const stats: { usedBytes: number, totalBytes: number | null, tables: Record<string, number> } = {
        usedBytes: 0,
        totalBytes: null, // Cannot reliably get localStorage limit directly
        tables: {}
    };
    const schema = getCurrentSchema(); // Get current list of tables

    try {
        // Estimate total usage by iterating through all keys (less accurate but necessary without specific API)
        let totalLocalStorageBytes = 0;
        for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            if (key) {
                const value = localStorage.getItem(key) || "";
                totalLocalStorageBytes += (key.length + value.length) * 2; // Estimate bytes (UTF-16)
            }
        }
        stats.usedBytes = totalLocalStorageBytes; // Use total estimate for overall usage

        // Estimate per-table usage based on schema
        schema.forEach(table => {
            const key = `${STORAGE_PREFIX_PERSIST}${table.id}_data`;
            const value = localStorage.getItem(key);
            if (value !== null) {
                stats.tables[table.id] = (key.length + value.length) * 2; // Estimate bytes
            } else {
                stats.tables[table.id] = 0;
            }
        });

        // Attempt to use navigator.storage for quota estimate (may include more than localStorage)
        if (navigator.storage && navigator.storage.estimate) {
            navigator.storage.estimate().then(estimate => {
                stats.totalBytes = estimate.quota ?? null; // Assign estimated quota
            }).catch(err => console.warn("Could not estimate storage quota:", err));
        }

    } catch (error) {
        console.error("Error calculating storage stats:", error);
    }
    return stats;
}


