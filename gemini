// Restore data from backup (only restores tables present in the CURRENT schema)
export async function restoreFromBackup(
  backup: Record<string, any[]>,
  options: PersistenceOptions = {}
): Promise<boolean> {
    if (typeof window === 'undefined' || !localStorage) {
        console.error("localStorage not available. Cannot restore data.");
        options.onError?.(new Error("localStorage not available"));
        return false;
    }
    let overallSuccess = true;
    const restoreErrors: string[] = [];
    const schema = getCurrentSchema(); // Get current schema to know which tables to restore

    const restorePromises = schema.map(async (table) => {
        const tableId = table.id;
        const dataToRestore = backup[tableId];

        if (dataToRestore === undefined) {
            console.warn(`Skipping restore for ${tableId}: No data found in backup object.`);
            // Not necessarily an error, maybe the table is new since the backup
            return true; // Consider it success for this table
        }

        if (!Array.isArray(dataToRestore)) {
            console.warn(`Skipping restore for ${tableId}: Data in backup is not an array.`);
            restoreErrors.push(`${tableId}: Invalid data format (not an array)`);
            overallSuccess = false;
            return false;
        }

        // Optional: Add validation for each record in dataToRestore against the current schema
        // This could be slow for large backups.
        // dataToRestore.forEach(record => {
        //     const { valid, errors } = validateRecord(tableId, record);
        //     if (!valid) console.warn(`Record in backup for ${tableId} has validation issues:`, errors, record);
        // });

        const success = await saveData(tableId, dataToRestore, {
            retryOnFailure: options.retryOnFailure,
            onError: (err) => {
                console.error(`Error restoring ${tableId}:`, err);
                restoreErrors.push(`${tableId}: ${err.message}`);
                // Don't set overallSuccess to false here, saveData might retry
            }
        });

        if (!success) {
            overallSuccess = false; // Mark overall failure if saveData ultimately fails
        }
        return success;
    });


    try {
        await Promise.all(restorePromises);

        if (overallSuccess) {
            console.log("Restore completed.");
            options.onSuccess?.();
        } else {
            const errorMsg = `Restore completed with errors: ${restoreErrors.join("; ")}`;
            console.error(errorMsg);
            options.onError?.(new Error(errorMsg));
        }
        return overallSuccess;
    } catch (error) {
        console.error("Unexpected error during restore process:", error);
        const typedError = error instanceof Error ? error : new Error("Unknown error during restore process");
        options.onError?.(typedError);
        return false;
    }
}


