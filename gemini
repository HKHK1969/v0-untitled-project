/******************************************************************************
 * components/enhanced-select.tsx (Refactored Component)
 ******************************************************************************/
"use client"

// Imports handled globally

// Constants
const ADD_NEW_VALUE_ENHANCED = "__add_new__"; // Renamed
const DEFAULT_PLACEHOLDER_ENHANCED = "Select..."; // Renamed

// Type definitions
// type SafeValue = string | number | boolean | Date | object | null | undefined; // Defined above
interface EnhancedSelectProps<T extends SafeValue> {
  id: string;
  label: string;
  value: T; // Can be complex type
  options: T[]; // Array of complex types or strings/numbers
  getOptionValue?: (option: T) => string; // Function to get the string value for <option value="...">
  getOptionLabel?: (option: T) => string; // Function to get the string label for display
  onValueChange: (selectedValue: string) => void; // Returns the string value of the selected option
  onAddOption?: (newLabel: string) => void; // Optional: Callback to handle adding a new option (by label)
  required?: boolean;
  placeholder?: string;
  error?: string;
  disabled?: boolean;
  maxOptions?: number; // Primarily relevant if onAddOption is provided
}

// Default helpers if not provided
const defaultGetOptionValue = (option: SafeValue): string => safeToString(option);
const defaultGetOptionLabel = (option: SafeValue): string => safeToString(option);

export const EnhancedSelect = memo(function EnhancedSelect<T extends SafeValue>({
  id,
  label,
  value,
  options = [],
  getOptionValue = defaultGetOptionValue, // Use defaults
  getOptionLabel = defaultGetOptionLabel, // Use defaults
  onValueChange,
  onAddOption, // Optional callback
  required = false,
  placeholder = DEFAULT_PLACEHOLDER_ENHANCED,
  error,
  disabled = false,
  maxOptions = Number.POSITIVE_INFINITY,
}: EnhancedSelectProps<T>) {
  const [isAddingNew, setIsAddingNew] = useState(false);
  const [newOptionLabel, setNewOptionLabel] = useState(""); // Store the label being added
  const [validationError, setValidationError] = useState("");

  // Convert current complex value to its string representation for the <select> value
  const currentSelectValue = value !== null && value !== undefined ? getOptionValue(value) : "";

  // Generate options for the select dropdown
  const selectOptions = useMemo(() => {
    return options.map((option, index) => ({
      value: getOptionValue(option),
      label: getOptionLabel(option),
      key: `${id}-opt-${getOptionValue(option)}-${index}` // More robust key
    }));
  }, [options, getOptionValue, getOptionLabel, id]);

  // Check if the "Add new" option should be available
  const canAddNew = !!onAddOption && !disabled && selectOptions.length < maxOptions;

  // Handle adding a new option via the dialog
  const handleAddOptionConfirm = useCallback(() => {
    const trimmedLabel = newOptionLabel.trim();
    setValidationError("");

    if (!trimmedLabel) {
      setValidationError("Please enter a label for the new option.");
      return;
    }
    // Check if an option with the same LABEL already exists
    if (selectOptions.some(opt => opt.label === trimmedLabel)) {
      setValidationError("An option with this label already exists.");
      return;
    }

    if (onAddOption) {
        onAddOption(trimmedLabel); // Call the provided handler
        // It's the responsibility of the parent component (using onAddOption)
        // to update the `options` prop and potentially select the new value.
        setIsAddingNew(false);
        setNewOptionLabel("");
    } else {
        console.error("onAddOption callback is missing, cannot add new option.");
        setValidationError("Cannot add option: Configuration error.");
    }

  }, [newOptionLabel, onAddOption, selectOptions]); // Add dependencies

  // Handle dialog escape key
   const handleDialogKeyDown = useCallback((e: KeyboardEvent) => {
       if (e.key === "Escape") {
           setIsAddingNew(false);
           e.preventDefault();
       }
   }, []);


   useEffect(() => {
       if (isAddingNew) document.addEventListener("keydown", handleDialogKeyDown);
       else document.removeEventListener("keydown", handleDialogKeyDown);
       return () => document.removeEventListener("keydown", handleDialogKeyDown);
   }, [isAddingNew, handleDialogKeyDown]);


  return (
    <>
      <Select
        value={currentSelectValue} // Controlled component using string value
        onValueChange={(selectedValue) => {
          if (selectedValue === ADD_NEW_VALUE_ENHANCED) {
            if (canAddNew) {
                setValidationError("");
                setNewOptionLabel("");
                setIsAddingNew(true);
            } else if (!onAddOption) {
                 toastMock({ title: "Info", description: "Adding options is not configured for this select." });
             } else if (disabled) {
                  toastMock({ title: "Info", description: "Select is disabled." });
             } else {
                 toastMock({ title: "Limit Reached", description: `Maximum options (${maxOptions}) reached.` });
             }
          } else {
            onValueChange(selectedValue); // Notify parent of the selected *value* string
          }
        }}
        disabled={disabled}
      >
        <SelectTrigger
          id={id}
          aria-invalid={!!error} // Only show external error state on trigger
          className={error ? "border-destructive" : ""}
          aria-label={label}
        >
          {/* Display the label of the current value, or placeholder */}
          <SelectValue placeholder={placeholder}>
            {value !== null && value !== undefined ? getOptionLabel(value) : placeholder}
          </SelectValue>
        </SelectTrigger>
        <SelectContent>
           {/* Optional: Add a non-selectable placeholder item */}
           {/* <SelectItem value="" disabled>{placeholder}</SelectItem> */}

          {/* Render actual options */}
          {selectOptions.map(opt => (
            <SelectItem key={opt.key} value={opt.value}>
              {opt.label}
            </SelectItem>
          ))}

          {/* "Add new" option */}
          {canAddNew && (
            <SelectItem
              value={ADD_NEW_VALUE_ENHANCED}
              className="text-primary font-medium" // Mock class
              aria-label={`Add new ${label.toLowerCase()}`}
            >
               <div style={{ display: 'flex', alignItems: 'center' }}>
                 <Plus className="mr-2 h-4 w-4" /> Add new...
               </div>
            </SelectItem>
          )}
           {/* Indicate max options reached */}
           {!disabled && !!onAddOption && selectOptions.length >= maxOptions && (
               <SelectItem value="" disabled className="text-muted-foreground">Max options reached</SelectItem>
           )}
        </SelectContent>
      </Select>
       {/* Display external error message */}
       {error && <p className="text-xs text-destructive mt-1">{error}</p>}


      {/* Dialog for adding (only if onAddOption is provided) */}
      {!!onAddOption && (
          <Dialog open={isAddingNew} onOpenChange={setIsAddingNew}>
            <DialogContent className="sm:max-w-[425px]">
              <DialogHeader>
                <DialogTitle>Add New {label}</DialogTitle>
              </DialogHeader>
              <div className="grid gap-4 py-4">
                <div className="grid gap-2">
                  <Label htmlFor={`new-option-label-${id}`}>New Option Label</Label>
                  <Input
                    id={`new-option-label-${id}`}
                    value={newOptionLabel}
                    onChange={(e) => { setNewOptionLabel(e.target.value); setValidationError(""); }}
                    placeholder={`Enter label for new ${label.toLowerCase()}`}
                    className={validationError ? "border-destructive" : ""}
                    autoFocus
                    onKeyDown={(e) => { if (e.key === "Enter") { e.preventDefault(); handleAddOptionConfirm(); } }}
                  />
                  {validationError && <p className="text-xs text-destructive">{validationError}</p>}
                </div>
              </div>
              <DialogFooter>
                <Button variant="outline" onClick={() => setIsAddingNew(false)}>Cancel</Button>
                <Button onClick={handleAddOptionConfirm}>Add Option</Button>
              </DialogFooter>
            </DialogContent>
          </Dialog>
       )}
    </>
  );
}) as <T extends SafeValue>(props: EnhancedSelectProps<T>) => JSX.Element;
